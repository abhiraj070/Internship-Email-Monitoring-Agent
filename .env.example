# Internship Email Monitoring Agent - Environment Configuration

# Discord Webhook URL for incoming notifications
DISCORD_WEBHOOK_URL="https://discord.com/api/webhooks/your_webhook_id/your_webhook_token"

# Google / Gmail API Credentials
GMAIL_CREDENTIALS_PATH="credentials.json"
GMAIL_TOKEN_PATH="token.json"

# Search filter for retrieving emails (e.g. 'is:unread', 'newer_than:2d', or 'label:inbox')
GMAIL_SEARCH_QUERY="is:unread"
MAX_EMAILS_PER_POLL=20

# Interval between polling cycles in seconds (e.g., 300 for 5 minutes)
CHECK_INTERVAL_SECONDS=300

# Optional: Gemini API Key for enhanced contextual classification
GEMINI_API_KEY=""

# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL="INFO"
